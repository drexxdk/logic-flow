{
  "name": "logic-flow-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm --filter logic-flow build && pnpm --filter demo build",
    "dev": "pnpm --filter demo dev",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --filter eslint-plugin-logic-flow test && pnpm --filter logic-flow test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-plugin-logic-flow": "workspace:*",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}

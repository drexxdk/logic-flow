{
  "name": "logic-flow",
  "version": "0.1.0",
  "description": "A code-first workflow runtime for TypeScript and Zod.",
  "keywords": [
    "workflow",
    "state-machine",
    "typescript",
    "zod",
    "xstate"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drexxdk/logic-flow.git"
  },
  "homepage": "https://github.com/drexxdk/logic-flow#readme",
  "bugs": {
    "url": "https://github.com/drexxdk/logic-flow/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.4"
  }
}
